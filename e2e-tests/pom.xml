<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ecommerce</groupId>
        <artifactId>ecommerce-microservices</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>e2e-tests</artifactId>
    <name>e2e-tests</name>
    <description>Testes ponta a ponta contra os quatro serviços em execução</description>

    <properties>
        <!--
          Estes testes exigem a pilha completa no ar e por isso não rodam no
          `mvn verify` comum, que precisa funcionar em qualquer máquina.
          Para executá-los, suba o docker compose e rode:
          ./mvnw -pl e2e-tests verify -Dskip.e2e=false
        -->
        <skip.e2e>true</skip.e2e>
    </properties>

    <dependencies>
        <!--
          Sem Spring de propósito: o teste enxerga os serviços como um cliente
          qualquer enxergaria, por HTTP, sem compartilhar classe nenhuma com eles.
          Se um contrato quebrar, este teste quebra junto.
        -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <skipITs>${skip.e2e}</skipITs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
