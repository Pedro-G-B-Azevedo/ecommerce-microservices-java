# Copie para .env e ajuste conforme necessário: docker compose lê este arquivo
# automaticamente. O .env real está no .gitignore e nunca deve ser commitado.

AUTH_DB_USER=auth
AUTH_DB_PASSWORD=auth

ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=orders

INVENTORY_DB_USER=inventory
INVENTORY_DB_PASSWORD=inventory

NOTIFICATION_DB_USER=notification
NOTIFICATION_DB_PASSWORD=notification

# Contas criadas na primeira subida do auth-service.
# TROQUE ESTES VALORES fora de desenvolvimento.
AUTH_ADMIN_EMAIL=admin@ecommerce.local
AUTH_ADMIN_PASSWORD=troque-esta-senha-admin
AUTH_SERVICE_ACCOUNT_EMAIL=orders-service@ecommerce.local
AUTH_SERVICE_ACCOUNT_PASSWORD=troque-esta-senha-servico

# Credenciais com que o orders-service se identifica perante o inventory-service.
SERVICE_ACCOUNT_EMAIL=orders-service@ecommerce.local
SERVICE_ACCOUNT_PASSWORD=troque-esta-senha-servico

# Chaves RSA em PEM. Sem elas, o auth-service gera um par efêmero ao subir
# e os tokens deixam de valer a cada reinício.
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

# Origem do front-end, liberada por CORS nos quatro serviços.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# URLs que o front-end embute no bundle ao ser construído (o Vite resolve
# isto em tempo de build, não de execução). Os padrões já apontam para as
# portas publicadas pelo docker-compose.
# VITE_AUTH_URL=http://localhost:8081
# VITE_ORDERS_URL=http://localhost:8082
# VITE_INVENTORY_URL=http://localhost:8083
# VITE_NOTIFICATIONS_URL=http://localhost:8084
